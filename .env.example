# ==============================================================================
# Rapply - Environment Variables Configuration Template
# ==============================================================================

# Database Connection (PostgreSQL / Neon / Supabase)
DATABASE_URL="postgresql://user:password@localhost:5432/rapply?sslmode=prefer"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# JWT Secret for Session Cookies
JWT_SECRET="replace_with_a_secure_random_base64_string"

# Web Push Notifications (VAPID Keys)
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="your_vapid_public_key"
VAPID_PRIVATE_KEY="your_vapid_private_key"
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your_vapid_public_key"

# Secret Token for Cron Background Triggers (/api/push/send, /api/push/digest)
CRON_SECRET="replace_with_a_random_secret_for_cron"

# Node Environment
NODE_ENV="development"
